{
  "openapi": "3.1.0",
  "info": {
    "title": "Quick notes",
    "description": "Quick Notes is a small web app to keep short notes. A user can create a note with a title (required, max 100 characters) and text (max 2,000 characters). The user sees all notes in a list, newest first, with a message when there are no notes. The user can delete a note after confirming. The user can export all notes as one Markdown file; the file name is made from the date, and the number of exported notes is limited by a setting (default 100). No sign-in. Two sprints: sprint 1 is create and list, sprint 2 is delete and export.",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Me",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "List Notes",
        "description": "Return every note in the shared store, newest-created-first (AC-005, AC-006).",
        "operationId": "list_notes_notes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/NoteRead"
                  },
                  "type": "array",
                  "title": "Response List Notes Notes Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "summary": "Create Note",
        "description": "Validate the title and body and save the note (AC-001, AC-002, AC-003, AC-004).\n\n`NoteCreate`'s own field constraints reject a missing/empty title (AC-002) and a\ntitle or body past its length limit (AC-003, AC-004) with a 422 before this body\never runs, so a note reaching here is always saved (AC-001).",
        "operationId": "create_note_notes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteRead"
                }
              }
            }
          },
          "422": {
            "description": "Title is required and must be 1 to 100 characters; body must be 2,000 characters or fewer."
          }
        }
      }
    },
    "/notes/export": {
      "get": {
        "tags": [
          "Notes"
        ],
        "summary": "Export Notes",
        "description": "Assemble the most recent notes into one Markdown file (AC-013, AC-014, AC-015).\n\nRaises `NOTE_EXPORT_EMPTY` (404) when the shared store has no notes at all, rather\nthan downloading an empty file nobody asked for (AC-015). Otherwise the file is\nreturned with its date-derived filename on `Content-Disposition` (AC-014), so the\nbrowser downloads it under that name with no email or cloud delivery involved\n(AC-013). The number of notes included is whatever the export-limit setting\ncurrently holds (AC-019), not a fixed value, so changing it through PUT /settings\nchanges the next export without anything else here having to change.",
        "operationId": "export_notes_notes_export_get",
        "responses": {
          "200": {
            "description": "A single Markdown (.md) file assembled from the most recent notes, up to the export limit, with a filename derived from today's date (AC-013, AC-014).",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "There are no notes to export."
          }
        }
      }
    },
    "/notes/{note_id}": {
      "delete": {
        "tags": [
          "Notes"
        ],
        "summary": "Delete Note",
        "description": "Permanently delete one note from the shared store (AC-009, AC-010, AC-012).\n\nAny visitor may delete any note (NFR-001): there is no owner check. A missing or\nalready-deleted id raises the 404 this route advertises rather than succeeding\nsilently, so a caller retrying a stale id finds out it is gone.",
        "operationId": "delete_note_notes__note_id__delete",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Note Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Note not found."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get Settings",
        "description": "Return the current export-limit setting, defaulting to 100 (AC-018).",
        "operationId": "get_settings_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsRead"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Update Settings",
        "description": "Change the export-limit setting to a positive whole number (AC-019, AC-020).\n\n`SettingsUpdate`'s own field constraints reject a non-positive or non-integer\nvalue with a 422 before this body ever runs.",
        "operationId": "update_settings_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsRead"
                }
              }
            }
          },
          "422": {
            "description": "Export limit must be a positive whole number."
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe, and the only route here that is not a stub.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "CurrentUser"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "LoginResponse"
      },
      "NoteCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "title": "Body",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "NoteCreate",
        "description": "Request body of POST /notes (AC-001, AC-002, AC-003, AC-004)."
      },
      "NoteRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "createdAt"
        ],
        "title": "NoteRead",
        "description": "A saved note, as returned by POST /notes (AC-001)."
      },
      "SettingsRead": {
        "properties": {
          "exportLimit": {
            "type": "integer",
            "title": "Exportlimit"
          }
        },
        "type": "object",
        "required": [
          "exportLimit"
        ],
        "title": "SettingsRead",
        "description": "The current export-limit setting, as returned by GET /settings (AC-018)."
      },
      "SettingsUpdate": {
        "properties": {
          "exportLimit": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Exportlimit"
          }
        },
        "type": "object",
        "required": [
          "exportLimit"
        ],
        "title": "SettingsUpdate",
        "description": "Request body of PUT /settings (AC-019, AC-020).\n\n`export_limit` must be a positive whole number: `gt=0` rejects zero and negative\nvalues, and the `int` type itself rejects anything that is not a whole number."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
